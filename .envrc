# Watch for changes in dependencies
watch_file MODULE.bazel.lock



# Dynamically set PATH based on Bazel toolchains
# We use cquery to find the absolute paths of the tools
# and add their directories to PATH.
# Determine OS/Arch early for cache segregation
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
ARCH=$(uname -m)

# Standardize architecture names
if [ "$ARCH" = "x86_64" ]; then
    BAZEL_ARCH="amd64"
elif [ "$ARCH" = "aarch64" ]; then
    BAZEL_ARCH="arm64"
else
    echo "Unsupported architecture: $ARCH" >&2
    return 1
fi

# Use architecture-specific cache directory to avoid conflicts (host vs container)
CACHE_DIR=".cache/${OS}_${BAZEL_ARCH}"
mkdir -p "$CACHE_DIR/bin"

# Add local bin to PATH early so it takes precedence
PATH_add "$CACHE_DIR/bin"

# Check if bazel is locally available (bootstrapped by setup script)
if [ -f "$CACHE_DIR/bin/bazel" ]; then
    cache_file="$CACHE_DIR/bazel_path_cache"
    
    # Load from cache if it exists
    if [ -f "$cache_file" ]; then
        watch_file "$cache_file"
        source "$cache_file"
    else
        echo "Environment cache missing." >&2
        echo "Please run './tools/setup_dev_env.sh' to initialize." >&2
        # Start a subshell? Or just return?
        # direnv will stop if we exit 1? 
        # "direnv: error ..."
        return
    fi
else
    echo "Bazel not bootstrapped." >&2
    echo "Please run './tools/setup_dev_env.sh' to initialize." >&2
    return
fi
